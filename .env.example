# ---------------------------------------------------------------------------
# Puzzly environment
#
# The app is fully playable with NONE of these set: it falls back to in-memory
# rooms, local-disk blobs and the built-in "Puzzly Originals" image gallery.
# That mode is correct for `npm run dev` and for any single-process host, but
# multiplayer is only reliable across serverless instances once the Supabase
# variables below are configured. See README.md > Deployment modes.
# ---------------------------------------------------------------------------

# --- Supabase: durable state + realtime fan-out (free tier) -----------------
# Project settings > API. The URL and anon key are PUBLIC by design: the browser
# needs them to subscribe to the realtime channel. Row Level Security is enabled
# with no policies (see sql/schema.sql), so the anon key can read nothing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-side only — never referenced from a client component.
# Bypasses RLS, so this is the only key that can read or write room state.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed if the server should talk to a different host than the
# browser does. Defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Storage bucket for uploaded images. Create it as PRIVATE; images are served
# back through /api/blob/[id] so the canvas stays same-origin and untainted.
SUPABASE_STORAGE_BUCKET=puzzly-images

# --- Stock image providers (entirely optional) ------------------------------
# Leave blank and the Browse tab shows "Puzzly Originals" only. Both keys are
# server-side only; images are proxied so the keys never reach the browser.
# https://unsplash.com/developers  (Demo tier: 50 requests/hour)
UNSPLASH_ACCESS_KEY=
# https://www.pexels.com/api/  (Free tier: 200 requests/hour)
PEXELS_API_KEY=

# --- Misc -------------------------------------------------------------------
# Canonical origin, used for invite links in server-rendered contexts.
# Vercel sets VERCEL_URL automatically; only set this for a custom domain.
NEXT_PUBLIC_SITE_URL=
