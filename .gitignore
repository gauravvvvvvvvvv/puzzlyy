# --- dependencies ----------------------------------------------------------
node_modules

# --- build output ----------------------------------------------------------
.next
out
build
*.tsbuildinfo

# Generated by Next on every `dev`/`build`.
next-env.d.ts

# --- local runtime state ---------------------------------------------------
# Room records and uploaded blobs written by the filesystem adapters in
# zero-config mode. Never meant to be shared.
.data

# --- environment -----------------------------------------------------------
# Ignore every env file, then re-admit the committed template. Order matters:
# the negation must follow the broad pattern or it has no effect.
.env*
!.env.example

# --- tooling ---------------------------------------------------------------
.vercel

# --- logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- editors / OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# --- credentials -----------------------------------------------------------
*.pem
